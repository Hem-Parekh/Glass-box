      "css": ".ds-fld{display:grid;gap:6px;font-family:'Hanken Grotesk',system-ui,sans-serif;max-width:260px}.ds-fld>span:first-child{font-size:13.5px;color:#47443E}.ds-in{display:flex;border:1px solid #CFC9BC;border-radius:4px;background:#fff;overflow:hidden;transition:border-color .15s,box-shadow .15s}.ds-in:focus-within{border-color:#7B5C1F;box-shadow:0 0 0 3px rgba(176,132,51,.12)}.ds-in input{flex:1;min-width:0;border:0;background:transparent;color:#16171A;font:inherit;font-size:14.5px;padding:8px 10px;outline:none;font-variant-numeric:tabular-nums}.ds-in em{font-style:normal;font-size:12.5px;color:#6A665D;padding:8px 9px;border-left:1px solid #E2DED5;background:#F7F6F3}"
